# Copy to .env and fill in. Never commit .env.

# --- Host ---
APP_BASE_URL=http://localhost:3000
APP_KEY_SECRET=replace-with-a-long-random-string

# --- Auth0 (Regular Web Application) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional API audience for /authorize and token refresh. Leave empty for this Regular Web App lab.
# AUTH0_AUDIENCE=

# --- Looker API (SDK) ---
LOOKER_BASE_URL=https://your-instance.cloud.looker.com
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
LOOKER_VERIFY_SSL=true
LOOKER_EMBED_HOST=https://your-instance.cloud.looker.com
LOOKER_EMBED_DASHBOARD_ID=

# Embed user grants passed to acquire_embed_cookieless_session.
# external_user_id / first / last / email come from the Auth0 id token.
# Whole Looker cookieless session length in seconds (nav/api cannot outlive this).
# This overrides the fallback in app/config.py. Restart, then End Looker and
# acquire again: generate and reattach do not extend an existing session.
# Looker chooses navigation and API TTLs (about 10 min). A session shorter than
# that caps both, including later generate_tokens. There is no separate TTL field.
# Use 720 (12 min) for demos so the dashboard is viewable; 120 is only for fast teaching timeouts.
LOOKER_EMBED_SESSION_LENGTH=720
LOOKER_EMBED_FORCE_LOGOUT_LOGIN=true
LOOKER_EMBED_GROUP_IDS=1
LOOKER_EMBED_EXTERNAL_GROUP_ID=cookieless-lab
LOOKER_EMBED_MODELS=dw_v3
LOOKER_EMBED_PERMISSIONS=access_data,see_looks,see_user_dashboards
# Cold-start dashboard filters for the Embed SDK tab (Looker filter names Periodo / Gestor).
LOOKER_EMBED_FILTER_PERIODO=4 months
LOOKER_EMBED_FILTER_GESTOR=CORIL

# Optional. Fully pinned ESM URL for /sequence. Default is mermaid 11.17.2 on jsDelivr.
# MERMAID_MODULE_URL=https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs
