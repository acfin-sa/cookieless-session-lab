%% Happy-path raw postMessage flow. Not the Embed SDK client and not a failure matrix.
%% flowchart TB: renders in Cursor Mermaid preview and on /sequence.
flowchart TB
  subgraph layerA["Layer A — host login"]
    A1["Browser GET /login"]
    A2["Host GET /authorize PKCE → Auth0"]
    A3["Auth0 redirect /callback?code="]
    A4["Host POST /oauth/token → Auth0 tokens on server only"]
    A5["Set-Cookie host_session_id HttpOnly"]
    A6["Browser POST /api/host/bootstrap → host_access_token in memory"]
    A1 --> A2 --> A3 --> A4 --> A5 --> A6
  end

  subgraph acquire["Looker acquire"]
    B1["Browser POST /api/looker/acquire-embed-session Bearer host_access_token"]
    B2["Host POST /embed/cookieless_session/acquire"]
    B3["Looker returns 4 tokens; session_reference_token stored server-side only"]
    B4["Browser gets authentication_token, navigation_token, api_token + TTLs"]
    B1 --> B2 --> B3 --> B4
  end

  subgraph embed["Iframe bootstrap"]
    C1["Browser GET /login/embed?embed_authentication_token="]
    C2["authentication_token consumed single-use ~30s"]
    C3["Iframe postMessage session:tokens:request"]
    C4["Browser postMessage session:tokens nav + api from acquire"]
    C1 --> C2 --> C3 --> C4
  end

  subgraph renew["Nav/api renewal loop"]
    D1["Iframe session:tokens:request when nav or api in last 60s"]
    D2["Browser PUT /api/looker/generate-embed-tokens"]
    D3["Host PUT generate_tokens with session_reference + last nav/api"]
    D4["Looker new nav + api; session_reference TTL counts down"]
    D5["Browser postMessage session:tokens"]
    D1 --> D2 --> D3 --> D4 --> D5
    D5 -.->|"repeat while session lives"| D1
  end

  subgraph reattach["Second iframe reattach"]
    E1["Browser POST acquire-embed-session again"]
    E2["Host acquire with stored session_reference_token"]
    E3["New authentication_token; same session countdown"]
    E1 --> E2 --> E3
  end

  subgraph logout["Logout"]
    F1["Browser POST /logout"]
    F2["Host DELETE cookieless session; Auth0 revoke refresh"]
    F3["Clear cookie; Auth0 /v2/logout"]
    F1 --> F2 --> F3
  end

  A6 --> B1
  B4 --> C1
  C4 --> D1
  D5 --> E1
  E3 --> F1
