%% Looker four-token lifecycle. Renewal is explicit.
%% flowchart TB: renders in Cursor Mermaid preview (sequenceDiagram is not supported there).
%% session_reference_token: one countdown. nav + api rotate together. auth token is single-use.
flowchart TB
  subgraph fresh["1 Fresh acquire — no stored session_reference_token"]
    F1["Browser POST /api/looker/acquire-embed-session Bearer host_access_token"]
    F2["Host POST acquire with session_length LOOKER_EMBED_SESSION_LENGTH"]
    F3["Looker: session_reference_token + auth ~30s + nav/api ~10m each"]
    F4["Host stores reference; JSON has nav/api/auth + session_reference_token_ttl"]
    F1 --> F2 --> F3 --> F4
  end

  subgraph auth["2 authentication_token — not renewed by generate"]
    G1["Browser GET /login/embed with embed_authentication_token"]
    G2["Looker consumes auth token once; unused auth dies at ~30s TTL"]
    F4 --> G1 --> G2
  end

  subgraph firstAsk["3 First session:tokens:request — no generate yet"]
    H1["Iframe session:tokens:request"]
    H2["Host replies with acquire navigation_token + api_token + remaining session TTL"]
    H3["No session_reference_token in postMessage"]
    G2 --> H1 --> H2 --> H3
  end

  subgraph generate["4 generate_tokens — renew nav + api only"]
    I1["Looker asks again when nav or api inside last 60s"]
    I2["Browser PUT /api/looker/generate-embed-tokens empty body"]
    I3["Host calls Looker generate with stored reference + last nav + last api"]
    I4["Looker returns new nav + api; session_reference_token_ttl = seconds still left"]
    I5["Optional: new reference string stored; countdown does not restart"]
    I6["Browser session:tokens to iframe"]
    I1 --> I2 --> I3 --> I4 --> I5 --> I6
    I6 -.->|"repeat while session lives"| I1
  end

  subgraph dead["5 session_reference_token_ttl = 0"]
    J1["Looker or generate reports TTL 0"]
    J2["Host HTTP 409 SESSION_DEAD"]
    J3["Fresh acquire with no stored reference → new session_length countdown"]
    J1 --> J2 --> J3
  end

  subgraph reattach["6 Reattach — acquire with stored reference"]
    K1["Host POST acquire with session_reference_token"]
    K2["session_length ignored; new auth + nav + api"]
    K3["session_reference_token_ttl = seconds still left e.g. 775 when 900 and ~125s elapsed"]
    K1 --> K2 --> K3
  end

  H3 --> I1
  I6 --> K1
  I4 -.->|"TTL hits 0"| J1
  J3 --> F1
